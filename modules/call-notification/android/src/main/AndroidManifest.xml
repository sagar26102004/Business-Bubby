<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Lets an incoming call take over a LOCKED screen instead of sitting silently
    behind the lock. On Android 14+ this is granted at install only to apps
    whose core function is calling or alarms; Localo qualifies (in-app voice
    calls), but it must be declared to Google Play, and until then the user
    grants it by hand. Without it we fall back to the overlay route, and failing
    that to an ordinary ringing notification with Answer and Decline.
  -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <!-- The vibration that comes with a ring. -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <application>
    <!--
      Receives the incoming-call push.

      Priority beats the -1 that expo-notifications registers its own service
      with — deliberately low on their side, precisely so an app can take over.
      We do take over, and then hand the message straight back by calling super
      first thing; see the long comment in CallMessagingService for why that
      order is the entire point and must not be "tidied up".
    -->
    <service
      android:name="expo.modules.callnotification.CallMessagingService"
      android:exported="false">
      <intent-filter android:priority="100">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <!--
      The full-screen call screen.

      showWhenLocked/turnScreenOn are the manifest half of what the activity
      also asks for in code: the system needs to know BEFORE launching it that
      this may appear over the lock screen, or it queues it behind the keyguard
      instead.

      Its own empty taskAffinity keeps it out of the app's task, so answering
      opens the real app cleanly rather than stacking on top of a call screen;
      excludeFromRecents stops a call that rang out from being left in Recents.
    -->
    <activity
      android:name="expo.modules.callnotification.IncomingCallActivity"
      android:exported="false"
      android:launchMode="singleTop"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

    <!--
      Handles the Decline pill without opening the app. Not exported: only our
      own PendingIntent may trigger it, so no other app can dismiss a user's
      incoming call.

      FULLY QUALIFIED on purpose. A relative ".CallActionReceiver" is resolved
      against a package name at manifest-merge time, and this library manifest
      is merged into an app whose namespace is com.localo.app — if it ever
      resolved against that, Decline would throw ClassNotFoundException at the
      moment someone pressed it, with nothing failing at build time to warn us.
    -->
    <receiver
      android:name="expo.modules.callnotification.CallActionReceiver"
      android:exported="false" />
  </application>
</manifest>
