{
  "expo": {
    "name": "Localo",
    "slug": "localo",
    "scheme": "localo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f7a13fa0-fd47-4aba-a7d7-a36f008d2186"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Localo uses the camera to scan business QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Localo uses the camera so you can photograph what you're selling.",
          "photosPermission": "Localo uses your photos so you can add pictures of what you're selling."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Localo uses your location to show businesses and stalls near you.",
          "locationAlwaysAndWhenInUsePermission": "Localo shares a driver's live location with the owner and tracking customers while on a shift, even when the app is in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Localo uses your microphone for in-app voice calls with businesses."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#141414",
          "sounds": [
            "./assets/call_ringtone.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bitcode": false
    },
    "android": {
      "package": "com.localo.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7a13fa0-fd47-4aba-a7d7-a36f008d2186"
      }
    }
  }
}
