// Localo — Prisma schema (document model).
//
// This is hand-written to mirror the SQL migrations in ../../supabase/migrations,
// which remain the schema source of truth (they own RLS + triggers). Prisma only
// needs a typed view of the tables. To regenerate it from the live DB instead:
//   npx prisma db pull
// (the migrations own the DDL; never run `prisma migrate` against this DB).
//
// Every table stores the full domain object as `data` (jsonb) plus the scoping
// columns RLS/queries key on. The backend connects with a privileged/direct
// connection that BYPASSES RLS — access is enforced in src/authz.ts instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// profiles — one row per auth user (data = domain User). id FKs auth.users in
// the DB; Prisma doesn't model the auth schema, so the relation is omitted here.
model Profile {
  id        String   @id @db.Uuid
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

model Business {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  type      String
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([ownerId])
  @@index([type])
  @@map("businesses")
}

model Employee {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  data       Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@index([userId])
  @@map("employees")
}

