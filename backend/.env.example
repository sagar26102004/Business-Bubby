# Localo backend (Path B) configuration.
#
# Copy to `.env` and fill in YOUR OWN Supabase project's values.
# `.env` is gitignored — never commit real secrets.

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (the Expo web app).
# Use * only in local dev.
CORS_ORIGIN=*

# --- Database (Prisma) -------------------------------------------------------
# The DIRECT (privileged) Postgres connection to the SAME Supabase project the
# app uses (Path A shares this DB). Prisma bypasses RLS with this connection —
# the API enforces access itself (see src/authz.ts). Get it from Supabase:
#   Project Settings -> Database -> Connection string -> URI  (use the direct
#   5432 connection, or the pooled 6543 "Transaction" URL for serverless).
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-ref.supabase.co:5432/postgres

# --- Auth (Supabase JWT verification) ---------------------------------------
# The project's JWT secret, used to verify the HS256 Bearer tokens the app
# sends. Supabase: Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional: the Supabase project URL, only used in error messages / docs.
SUPABASE_URL=https://your-ref.supabase.co
