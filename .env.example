# Localo backend configuration.
#
# Copy this file to `.env` and fill in YOUR OWN Supabase project's values.
# `.env` is gitignored — never commit real keys. The anon key is safe to ship
# in the app bundle (Row-Level Security protects the data); the service_role
# key must NEVER go here or in the client.
#
# Expo exposes vars prefixed with EXPO_PUBLIC_ to the app at build time.
# After editing `.env`, restart the dev server so the values are picked up.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Backend selector --------------------------------------------------------
# Which backend the app talks to:
#   api      -> the Node/Express + Prisma server in ./backend (Path B).
#              Requires EXPO_PUBLIC_API_URL below AND the Supabase vars above
#              (the app signs in via Supabase and sends the JWT to the API).
#   supabase -> the app talks straight to Supabase (Path A).
#   mock     -> in-memory mock data (dev/offline; resets on reload).
# Leave unset to auto-pick: Supabase when configured, otherwise mock.
EXPO_PUBLIC_BACKEND=

# The Node/Express API base URL — only used when EXPO_PUBLIC_BACKEND=api.
# In local dev this is where `npm run dev` in ./backend serves (default :4000).
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Dev Tools ---------------------------------------------------------------
# The 🧪 Dev tools screen (/dev) is a TESTING HARNESS, not product: it lists
# every user, switches identity with the shared seed password, and creates real
# accounts/businesses on whichever backend is configured.
#
# A PRODUCTION BUILD ALWAYS DISABLES IT — `expo export` / EAS ignore this var
# entirely, so a stale `.env` can never leak the harness into a release.
# This var only has a say while the dev server is running:
#   false -> off, so you can rehearse what customers actually see.
#   unset / anything else -> on.
EXPO_PUBLIC_DEV_TOOLS=true

# "Call alerts on this phone" — the diagnostic card in Notifications that
# chases down why an incoming call didn't pop up (ring-chain checks, test ring,
# permission shortcuts, native ring log). Testing only: customers never see it.
#   true  -> on, EVEN IN A BUILT APP. This is how a preview APK keeps the panel
#            (a preview build is a release variant, so __DEV__ is false there).
#            eas.json sets it on the `development` and `preview` profiles.
#   false -> off, dev server included.
#   unset -> on with the dev server, off in any built app.
# NEVER set it on the `production` EAS profile — absence is what hides it there.
EXPO_PUBLIC_CALL_DIAGNOSTICS=true

# The shared password of the SEEDED test accounts, used by Dev Tools' identity
# switch and "Add a test account". It must NEVER be hardcoded in source: this
# app is a client, so anything in the code ships inside the bundle where anyone
# can read it — and since every login email is derived from the account's phone
# number, a known shared password means anyone can sign in as those accounts.
#
# Keep it here in your LOCAL .env only. Production builds (eas.json) do not set
# it, and `__DEV__` folds the whole dev-only branch out of a release bundle, so
# a release contains no seed password at all. Without it set, Dev Tools' switch
# and account creation refuse to run and say why.
EXPO_PUBLIC_SEED_PASSWORD=

# --- Media storage -----------------------------------------------------------
# Where NEW photo and video uploads go.
#
# READS ARE UNAFFECTED by this setting. A stored URL is absolute, so everything
# uploaded before the move to Cloudinary keeps loading from Supabase Storage
# forever — which is exactly why the `media` bucket and migration 0015 stay in
# place and must never be dropped.
#
#   unset / anything else -> cloudinary (the live path)
#   supabase              -> the original path, straight into the public `media`
#                            bucket. Kept working on purpose: flip this if
#                            Cloudinary is misconfigured, if its free tier runs
#                            out, or to prove the fallback still works.
EXPO_PUBLIC_MEDIA_BACKEND=

# Cloudinary itself needs NO EXPO_PUBLIC_ vars, deliberately. The cloud name,
# api key, signature and public_id all come back from the `cloudinary-sign` edge
# function, so switching Cloudinary accounts is one `supabase secrets set` and
# NOT a Play release that takes weeks to reach installed phones.
#
# The API SECRET must never be here: this is a client, and anything in the
# bundle is readable by anyone holding the APK. It would let them delete every
# asset in the account. These three live as FUNCTION secrets only:
#
#   supabase secrets set CLOUDINARY_CLOUD_NAME=<cloud name> \
#                        CLOUDINARY_API_KEY=<api key> \
#                        CLOUDINARY_API_SECRET=<api secret> \
#                        CLOUDINARY_UPLOAD_PRESET=localo_media
#   supabase functions deploy cloudinary-sign
#   supabase functions deploy delete-account   # it sweeps Cloudinary too
#
# See supabase/README.md for the upload preset settings, which are where the
# allowed formats and the max file size are actually enforced.
