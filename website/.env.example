# Copy to .env.local for `npm run dev`, and set the same three on Vercel.
# The anon/publishable key is public by design — RLS keeps `businesses` and
# `reviews` read-only for it — but it still lives in env, not code.
SUPABASE_URL=https://mzxslzouzmiswnrolcaq.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# The public address of this site, no trailing slash. Leave unset on Vercel
# until there's a domain: the production *.vercel.app address is used instead.
# NEXT_PUBLIC_SITE_URL=https://oneplace.in
